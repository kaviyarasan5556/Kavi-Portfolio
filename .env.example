# Copy to .env.local for local development, and add the same keys in
# Vercel > Project > Settings > Environment Variables.

# Public URL of the deployed site (no trailing slash). Used at build time for the
# canonical link, Open Graph tags, robots.txt and sitemap.xml.
VITE_SITE_URL=https://kaviyarasan.vercel.app

# Contact form (EmailJS). These are public client keys — safe in the browser.
# Create a service + template at https://www.emailjs.com/ then paste the IDs here.
# Without all three, the form shows an honest "not configured" message and a mailto fallback.
#
# Tip: copy the Template ID from EmailJS (looks like template_xxxxxxx), not the template name.
# Service ID, Template ID and Public Key must all be from the same EmailJS account.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
